{
  "name": "my-kakaotalk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first desktop messenger focused on friends and chat",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:server\" \"npm:web\"",
    "server": "node --watch server/index.js",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^38.0.0",
    "vite": "^6.1.0"
  },
  "engines": { "node": ">=22.13.0" }
}
